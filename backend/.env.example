# Postgres connection string. Local: postgres://meridian:meridian@localhost:5432/meridian
# TLS is used automatically for remote hosts (Railway public proxy); disabled for
# localhost/127.0.0.1, *.railway.internal, or when PGSSLMODE=disable.
DATABASE_URL=postgres://meridian:meridian@localhost:5432/meridian
# PGSSLMODE=disable

# JWT signing secret — REQUIRED in production (server refuses to start without it)
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated allowed browser origins (http://localhost:5173 is always allowed)
CORS_ORIGINS=https://meridian-charters.vercel.app

# Base URL of the frontend, used for invite links in emails
FRONTEND_URL=http://localhost:5173

# SendGrid API key. If empty, emails are printed to the console (and still logged in email_log)
SENDGRID_API_KEY=
EMAIL_FROM=Meridian Charters <noreply@meridian.test>

# Seller details printed on GST tax invoices (PLACEHOLDERS — replace with real values)
COMPANY_GSTIN=27AAAAA0000A1Z5
COMPANY_ADDRESS=Meridian Charters Pvt Ltd, General Aviation Terminal, Mumbai 400099

# Set to true to allow `npm run seed` outside NODE_ENV=development
SEED_DEMO=false

NODE_ENV=development
PORT=4000

# Empty legs (v1.1): where public booking-request notifications go (comma-separated).
# If empty, all active sales/admin users are emailed.
SALES_EMAIL=sales@meridian.test
# Who reviews new lister sign-ups (comma-separated). Defaults to all active admin and sales users.
# LISTER_REVIEW_EMAIL=
# Settings defaults inserted on migrate if missing (edit via Admin → Settings, not here):
#   empty_leg_discount_pct=60  empty_leg_auto_publish=false  empty_leg_min_notice_hours=6

# Payments (v1.2). PAYMENTS_PROVIDER = mock (default; no keys, in-app test payments) | razorpay.
# With razorpay the server REFUSES TO START unless all three Razorpay values are set.
# Secrets live only in the environment — never in the frontend, never in the repo.
PAYMENTS_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL to configure in the Razorpay dashboard: https://<api-host>/api/payments/webhook/razorpay
# Events: payment.captured, order.paid, virtual_account.credited, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=
# Mock provider signing secrets (optional; defaults mock_webhook_secret / mock_key_secret)
# MOCK_WEBHOOK_SECRET=mock_webhook_secret
# Settings defaults inserted on migrate if missing (edit via Admin → Settings):
#   payment_due_hours_before_departure=24  refund_full_days=7  refund_half_hours=48  refund_half_pct=50
#   empty_leg_payment_window_hours=2
