# Postgres connection string. Local: postgres://meridian:meridian@localhost:5432/meridian
# TLS is used automatically for remote hosts (Railway public proxy); disabled for
# localhost/127.0.0.1, *.railway.internal, or when PGSSLMODE=disable.
DATABASE_URL=postgres://meridian:meridian@localhost:5432/meridian
# PGSSLMODE=disable

# JWT signing secret — REQUIRED in production (server refuses to start without it)
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated allowed browser origins (http://localhost:5173 is always allowed)
CORS_ORIGINS=https://meridian-charters.vercel.app

# Base URL of the frontend, used for invite links in emails
FRONTEND_URL=http://localhost:5173

# SendGrid API key. If empty, emails are printed to the console (and still logged in email_log)
SENDGRID_API_KEY=
EMAIL_FROM=Meridian Charters <noreply@meridian.test>

# Seller details printed on GST tax invoices (PLACEHOLDERS — replace with real values)
COMPANY_GSTIN=27AAAAA0000A1Z5
COMPANY_ADDRESS=Meridian Charters Pvt Ltd, General Aviation Terminal, Mumbai 400099

# Set to true to allow `npm run seed` outside NODE_ENV=development
SEED_DEMO=false

NODE_ENV=development
PORT=4000
