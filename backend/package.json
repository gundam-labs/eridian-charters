{
  "name": "meridian-charters-backend",
  "version": "1.4.0",
  "description": "Meridian Charters — charter operations and empty-leg marketplace API",
  "main": "src/index.js",
  "private": true,
  "scripts": {
    "start": "node src/db/migrate.js && node src/db/import-operators.js && node src/db/seed-if-demo.js && node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "test": "node --test tests/pricing.test.js",
    "test:lifecycle": "node --test tests/lifecycle.test.js",
    "predeploy": "node src/db/migrate.js && node src/db/import-operators.js && node src/db/seed-if-demo.js",
    "serve": "node src/index.js",
    "test:empty-legs": "node --test tests/empty-legs.test.js",
    "test:payments": "node --test tests/payments.test.js",
    "test:listers": "node --test tests/listers.test.js",
    "import:operators": "node src/db/import-operators.js",
    "test:operators": "node --test tests/operators.test.js"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
