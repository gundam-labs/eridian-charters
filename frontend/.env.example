# API calls are same-origin: Vercel rewrites /api/* to Railway (vercel.json), Vite proxies it in dev.
# Set VITE_API_DIRECT=true to call VITE_API_URL directly instead (then set CORS_ORIGINS on the API).
VITE_API_DIRECT=false
VITE_API_URL=
# Show the "Demo accounts" panel on the login page outside dev mode (true/false)
VITE_SHOW_DEMO_ACCOUNTS=false
